# Safe local-development placeholders only. Do not add real credentials.
POSTGRES_DB=openinfra
POSTGRES_USER=openinfra
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
LOCAL_UID=1000
LOCAL_GID=1000
DATABASE_URL=postgres://openinfra:change-me-for-local-development@127.0.0.1:5432/openinfra
REDIS_URL=redis://127.0.0.1:6379
CONTROL_PLANE_GRPC_ADDR=127.0.0.1:50051
PROVIDER_AGENT_GRPC_ADDR=127.0.0.1:50052
PROVIDER_AGENT_PORT=50052
# Only used by the opt-in `COMPOSE_PROFILES=multi-node` stack (README's
# "Multi-provider, multi-validator local network"); the default single-
# provider stack ignores these.
PROVIDER_AGENT_2_PORT=50053
PROVIDER_AGENT_3_PORT=50054
# Only used by the opt-in `COMPOSE_PROFILES=chaos` stack
# (tests/e2e/suites/20-chaos-injection.sh's torn-connection scenario, issue
# #139); the default stack never starts toxiproxy, so these ports are
# unused otherwise.
TOXIPROXY_ADMIN_PORT=8474
TOXIPROXY_POSTGRES_PORT=15432
PROVIDER_AGENT_MAX_WORKLOADS=8
PROVIDER_AGENT_MAX_CPU_CORES=8.0
PROVIDER_AGENT_MAX_MEMORY_MB=16384
PROVIDER_AGENT_PIDS_LIMIT=128
SUBSTRATE_RPC_URL=http://127.0.0.1:9944
SUBSTRATE_SIGNER_KEY_FILE=../deployments/local/certs/bridge-key.pem
OPENINFRA_DEV_INSECURE=false
# Local Provider Agent mTLS identity generated by `make dev-up`.
TLS_CERT_FILE=../deployments/local/certs/client.crt
TLS_KEY_FILE=../deployments/local/certs/client.key
TLS_CA_FILE=../deployments/local/certs/ca.crt
TLS_SERVER_NAME=control-plane
# Used only when running the Control Plane directly on the host.
TLS_CLIENT_CA_FILE=../deployments/local/certs/ca.crt
